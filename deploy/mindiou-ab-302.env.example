# Isolated evaluator A/B instance. Do not use this file as the main production env.
# Copy the rendered values to /etc/mindiou-ab-302.env on the server.

PORT=8805
HOST=127.0.0.1
NODE_ENV=production
MINDIOU_STRICT_ENV=0

# 302.AI OpenAI-compatible Chat Completions endpoint.
# The application appends /chat/completions, so keep /v1 only here.
AI_PROVIDER=302ai
AI_API_KEY=PASTE_302_API_KEY_ON_SERVER
AI_BASE_URL=https://api.302.ai/v1
AI_MODEL=gpt-5.6-sol
OPENAI_CHAT_TIMEOUT_MS=45000

# Keep research on the existing public-web adapter.
RESEARCH_PROVIDER=public_web
RESEARCH_API_KEY=
RESEARCH_BASE_URL=
RESEARCH_MODEL=
OPENAI_RESEARCH_TIMEOUT_MS=45000

# A/B-only access code and secret are generated on the server.
MINDIOU_EARLY_ACCESS_CODES=ab302:REPLACE_WITH_RANDOM_TEST_CODE
MINDIOU_SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
MINDIOU_COOKIE_SECURE=0
MINDIOU_SESSION_TTL_SECONDS=3600

# Isolated SQLite and legacy-store paths.
DATA_DB_PATH=/var/lib/mindiou-ab-302/mindiou.sqlite
AUTH_STORE_PATH=/var/lib/mindiou-ab-302/auth-store.sqlite
LEARNING_STORE_PATH=/var/lib/mindiou-ab-302/spiral-store.json
MVP0_STORE_PATH=/var/lib/mindiou-ab-302/mvp0-store.json
MVP1_STORE_PATH=/var/lib/mindiou-ab-302/mvp1-store.json
TRAINING_STORE_PATH=/var/lib/mindiou-ab-302/training-store.json
COGNITIVE_REPAYMENT_STORE_PATH=/var/lib/mindiou-ab-302/cognitive-repayment-store.json
COGNITIVE_PROFILE_STORE_PATH=/var/lib/mindiou-ab-302/cognitive-profile-store.json
OWNERSHIP_STORE_PATH=/var/lib/mindiou-ab-302/ownership-store.json

MVP1_DEMO_FALLBACK=0
COGNITIVE_REPAYMENT_V1=1
MAX_ARTIFACT_CHARS=30000
MAX_REQUEST_BODY_BYTES=10485760
DAILY_ANALYSIS_LIMIT=20
USER_DAILY_AI_TOKEN_BUDGET=500000
AI_OUTPUT_TOKEN_RESERVE=12000

# The A/B instance does not need production service tokens or SMTP/STT.
LEARNING_API_TOKEN=
STT_PROVIDER=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
