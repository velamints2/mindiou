[Unit]
Description=MindIOU SQLite consistent backup
After=mindiou.service

[Service]
Type=oneshot
User=mindiou
Group=mindiou
WorkingDirectory=/opt/mindiou
EnvironmentFile=/etc/mindiou.env
Environment=DATABASE_BACKUP_DIR=/var/lib/mindiou/backups
Environment=DATABASE_BACKUP_RETENTION_DAYS=30
ExecStart=/usr/bin/node scripts/backup-database.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mindiou
