[Unit]
Description=MindIOU trace alert check
After=mindiou.service

[Service]
Type=oneshot
User=mindiou
Group=mindiou
WorkingDirectory=/opt/mindiou
EnvironmentFile=/etc/mindiou.env
Environment=MINDIOU_DATA_VOLUME=/var/lib/mindiou
Environment=MINDIOU_TRACE_FILE=/var/lib/mindiou/traces.ndjson
ExecStart=/usr/bin/node ops/check-alerts.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/mindiou
