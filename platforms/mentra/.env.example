# ─── MentraOS 侧（https://console.mentra.glass 创建 App 获得）───
MENTRA_PACKAGE_NAME=com.mindiou.clearance
MENTRA_API_KEY=

# ─── MindIOU 共享后端 ───
# 生产：https://<域名>/mindiou-api  本地开发：http://127.0.0.1:8794
MINDIOU_API_BASE=http://127.0.0.1:8794
LEARNING_API_TOKEN=

# ─── TPA 服务端口 ───
# Mentra Cloud webhook 回调地址需公网可达
PORT=7010
