{
  "name": "evenhub-g2-learning",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "dev:desktop": "npm run dev & sleep 2 && NODE_ENV=development electron src/desktop/main.cjs",
    "api": "node --use-env-proxy --env-file-if-exists=.env.local server.js",
    "backup:db": "node scripts/backup-database.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:cards": "vitest run src/learning/*.test.ts",
    "test:desktop": "npm run check && npm run test:cards",
    "test:mvp1": "node scripts/mvp1-eval.mjs",
    "test:voice": "node scripts/voice-smoke-test.mjs",
    "test:spiral": "node scripts/spiral-smoke-test.mjs",
    "test:rokid": "node scripts/rokid-smoke-test.mjs",
    "test:simulator": "node scripts/pre-release-test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:ehpk": "node scripts/pack-ehpk.mjs",
    "launch-url": "node scripts/print-launch-url.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.11",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.1.2",
    "nodemailer": "^6.9.16",
    "typescript": "^5.7.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@types/node": "^22.13.1",
    "concurrently": "^9.0.1",
    "electron": "^32.3.3",
    "electron-is-dev": "^3.0.1",
    "happy-dom": "^20.11.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "vitest": "^3.2.4"
  }
}
