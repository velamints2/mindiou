# Keep real secrets in .env.local. That file is ignored by Git.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Optional independent OpenAI Responses web-search provider.
RESEARCH_PROVIDER=openai
RESEARCH_API_KEY=
RESEARCH_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL=gpt-5.5

# Optional independent speech-to-text provider. DeepSeek does not expose the
# OpenAI audio transcription contract.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe

# Legacy aliases remain supported for older local deployments.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# MVP-1 source-grounded exploration uses the Responses API web_search tool.
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_PROMPT=Learn Coach vocabulary study. Commands include 下一张, 下一个, 重复, 提问, 会了, next, repeat, ask me, got it.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. If set, enter the same value in Learn Coach phone Settings.
LEARNING_API_TOKEN=

# Spiral local event store and Codex collector.
LEARNING_STORE_PATH=tmp/spiral-store.json
SPIRAL_API_URL=http://localhost:8793
# macOS uses ":" between allowlisted absolute project paths.
SPIRAL_PROJECT_ALLOWLIST=
