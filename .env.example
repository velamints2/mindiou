# Keep real secrets in .env.local. That file is ignored by Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_PROMPT=Learn Coach vocabulary study. Commands include 下一张, 下一个, 重复, 提问, 会了, next, repeat, ask me, got it.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. If set, enter the same value in Learn Coach phone Settings.
LEARNING_API_TOKEN=
