# ─────────────────────────────────────────────────────────────────────────────
# MindIOU 后端环境变量示例（不含任何真实秘密）
#
# 用法：复制为 .env.local（本地开发，已被 .gitignore 忽略）后按需填写。
# 生产：写入服务器 /etc/mindiou.env（systemd EnvironmentFile），不要提交到 Git。
#
# 标注约定：
#   [必填-生产]   生产环境必须显式覆盖
#   [可选]        有安全默认值或可降级
#   [默认值安全]  默认值可直接使用
#   [秘密]        真实值禁止进入 Git / 日志 / 前端包
#
# 启动时 server.js 会验证本文件中的变量（env-validation.js）：
# 值非法 → 拒绝启动并给出变量级错误；缺失/偏弱 → 警告后继续。
# 设置 MINDIOU_STRICT_ENV=1 可将警告升级为启动错误（建议生产开启）。
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务监听 ─────────────────────────────────────────────────────────────────
# [可选][默认值安全] 本地默认 8793；生产经 Nginx 反代 127.0.0.1:8794，需设置 8794
PORT=8793
# [可选][默认值安全]
HOST=0.0.0.0
# [可选] production 时启用 Cookie Secure 等生产行为
NODE_ENV=development
# [可选] 设为 1 时，环境验证的警告会升级为启动错误（建议生产开启）
MINDIOU_STRICT_ENV=

# ── 文本生成模型 [必填-生产][秘密] ────────────────────────────────────────────
# 生产当前使用 deepseek（见 deploy/README.md）。缺失时进入内置 fallback。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# [可选][默认值安全] 文本生成超时（毫秒），默认 30000
OPENAI_CHAT_TIMEOUT_MS=30000

# ── 联网检索模型 [可选][秘密] ────────────────────────────────────────────────
# 独立供应商；未配置时检索降级为透明跳过/演示策展，不伪造来源。
RESEARCH_PROVIDER=openai
RESEARCH_API_KEY=
RESEARCH_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL=gpt-5.5
# [可选][默认值安全] 检索超时（毫秒），默认 45000
OPENAI_RESEARCH_TIMEOUT_MS=45000

# ── 语音转写 [可选][秘密] ────────────────────────────────────────────────────
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe
# [可选][默认值安全] STT 请求超时（毫秒），默认 30000
STT_TIMEOUT_MS=30000

# ── 旧别名（仍被 server.js 读取，仅用于兼容旧部署；新部署请用上方变量）────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_PROMPT=Learn Coach vocabulary study. Commands include 下一张, 下一个, 重复, 提问, 会了, next, repeat, ask me, got it.

# ── 访问控制 ─────────────────────────────────────────────────────────────────
# [必填-生产][秘密] 设备/服务通道 Bearer token（G2/Rokid/服务间调用）
LEARNING_API_TOKEN=
# [可选][秘密] 早期访问邀请码，逗号分隔 label:code；生成：openssl rand -hex 12
MINDIOU_EARLY_ACCESS_CODES=
# [必填-生产（启用邀请码时）][秘密] 至少 32 字节；生成：openssl rand -hex 32
MINDIOU_SESSION_SECRET=
# [可选][默认值安全] 会话有效期（秒），代码钳制到 300–2592000，默认 604800
MINDIOU_SESSION_TTL_SECONDS=604800
# [必填-生产] 生产 HTTPS 必须 1；本地 HTTP 测试用 0
MINDIOU_COOKIE_SECURE=0

# ── 行为开关 ─────────────────────────────────────────────────────────────────
# [可选] 设为 1 完全禁用 AI 调用（测试/演示固定样本用）
SPIRAL_DISABLE_AI=
# [可选] 设为 1 启用 MVP-1 策展降级（公开演示用；会产生 curated_demo_fallback 标记）
MVP1_DEMO_FALLBACK=

# ── 数据存储路径 [可选][默认值安全（开发）][必填-生产（建议 /var/lib/mindiou/）] ──
LEARNING_STORE_PATH=tmp/spiral-store.json
MVP0_STORE_PATH=tmp/mvp0-store.json
MVP1_STORE_PATH=tmp/mvp1-store.json
TRAINING_STORE_PATH=tmp/training-store.json
AUTH_STORE_PATH=tmp/auth-store.sqlite

# ── 其它（server.js 未读取，供本地工具使用）─────────────────────────────────
# agents/codex-collector 使用；macOS 用 ":" 分隔允许的绝对项目路径
SPIRAL_PROJECT_ALLOWLIST=

# Cognitive repayment V1 (evidence-bound gap repayment loop). Disabled by default.
COGNITIVE_REPAYMENT_V1=0
COGNITIVE_REPAYMENT_STORE_PATH=tmp/cognitive-repayment-store.json
# 历史遗留：server.js 未读取此变量，保留仅为兼容旧本地脚本
SPIRAL_API_URL=http://localhost:8793
